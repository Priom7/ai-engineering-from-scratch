PORT=4100
# Optional: set this only when you want to lock the backend to one frontend origin.
# If unset, local dev origins like localhost:5173, 5174, 5175 are allowed automatically.
# FRONTEND_ORIGIN=http://localhost:5174
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
MAX_CHUNK_SIZE=500
CHUNK_OVERLAP=80

TOP_K=4
